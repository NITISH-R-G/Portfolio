node_modules/
dist/
test-results/
*.cjs

.claude/settings.local.json

# Secrets read by `npm run import`. Never commit these.
.env
.env.local

# Connector output. Reproducible from your config by `npm run import`, so it is ignored by
# default to keep refreshes out of your git history.
#
# Comment this line out if you deploy from a CI job that cannot reach the platforms, or if
# you want your portfolio to build reproducibly from a checkout alone. The data is public
# either way — it came from your public profiles.
src/data/generated/

# Imported documents are NOT ignored: unlike connector output they cannot be regenerated,
# so a résumé you imported once is durable input and belongs in your repository.

# Copies of your own files made by `npm run example`. Restored by `npm run example -- restore`.
*.mine
src/data/generated/sources.mine/

# Generated by `npm run export`. Regenerate rather than commit — they are derived from your
# profile data, and a stale copy is worse than none.
exports/

# Benchmark runs (`npm run benchmark -- --json`). The fixtures and expected files are the
# durable part and are committed; a run's output is reproducible from them.
benchmarks/results/

# Playwright screenshots and capture sidecars from `--snapshot --render`. The frozen HTML is
# the fixture; these are debugging aids, and a screenshot of someone's profile is not something
# to commit by reflex.
benchmarks/fixtures/**/*.png

# Agent-skill tooling installed by `npx skills add`. Third-party skill content and a
# lockfile for it — developer tooling, not part of the portfolio engine, and deliberately
# not vendored into the repository.
.agents/
skills-lock.json

# Scratch probes used while benchmarking the embedding model.
scratch/
