{
  "name": "portfolio-engine",
  "version": "1.0.0",
  "description": "Connect your profiles. Your portfolio builds itself. An open-source, data-driven portfolio generator for developers, researchers and builders.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "import": "node scripts/import.mjs",
    "import:file": "node scripts/import-file.mjs",
    "export": "node scripts/export.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test",
    "deploy:check": "npm run doctor && npm run build",
    "example": "node scripts/example.mjs",
    "benchmark": "node benchmarks/run.mjs",
    "test:agent": "npm test --workspace @portfolio-engine/agent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NITISH-R-G/Portfolio.git"
  },
  "keywords": [
    "portfolio",
    "portfolio-generator",
    "developer-portfolio",
    "resume",
    "github",
    "static-site",
    "react",
    "vite",
    "open-source"
  ],
  "bugs": {
    "url": "https://github.com/NITISH-R-G/Portfolio/issues"
  },
  "homepage": "https://github.com/NITISH-R-G/Portfolio#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.62.1",
    "vite": "^8.1.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
