# Secrets for `npm run import`. Copy this file to `.env` and fill in what you want.
#
# Every key here is OPTIONAL. Leaving one blank does not break anything — that connector
# runs on its public rate limit, or reports itself "unavailable" and the rest of your
# portfolio imports normally. Nothing here is ever bundled into the built site: these are
# read by Node during the import, never by the browser.
#
# See docs/connectors.md for exactly what each one unlocks.

# GitHub — raises the API rate limit from 60 to 5,000 requests/hour, and is the only way to
# read pinned repositories and your contribution total. A token with no scopes is enough
# for public data. https://github.com/settings/tokens
GITHUB_TOKEN=

# Stack Exchange — raises the daily quota from 300 requests to 10,000.
# https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# Semantic Scholar — a dedicated rate limit instead of the shared anonymous pool.
# Free on request: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_KEY=

# YouTube — switches from the public channel feed (15 most recent videos, no view counts)
# to the official Data API, which adds view counts and your full upload history.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Hugging Face — only needed to read private repositories. Public models, datasets and
# Spaces import without it.
HUGGINGFACE_TOKEN=

# GitLab — only needed for a self-hosted instance or internal projects.
GITLAB_TOKEN=

# Kaggle — REQUIRED for the Kaggle connector; every Kaggle API endpoint needs credentials.
# Download kaggle.json from https://www.kaggle.com/settings and copy the two values here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Analytics (optional). A POST endpoint you control that accepts JSON: { events: [...] }.
# No third-party script, no cookies. Leave blank to collect nothing.
VITE_ANALYTICS_ENDPOINT=
